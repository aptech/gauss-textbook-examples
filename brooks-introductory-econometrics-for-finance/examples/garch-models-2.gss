new;
cls;
library timeseries;

/*
** Example 2: GARCH with Student's t errors
** Brooks Chapter 9 - Alternative error distributions
**
** Shows, in order: a GARCH(1,1) with normal errors, the same model with
** Student's t errors, and a table that compares the two fits.
*/

// Create path to data folder
data_file = __FILE_DIR $+ "../raw data/macro.dta";

// Load the data
macro = loadd(data_file);

// Extract S&P 500 returns
rsandp = packr(macro[., "rsandp"]);

// GARCH(1,1) with normal errors (the default)
struct garchResult fit_norm;
fit_norm = garchFit(rsandp, garch=1, arch=1);
print "";

// The same model with Student's t errors: adds the degrees of freedom
struct garchResult fit_t;
fit_t = garchFit(rsandp, garch=1, arch=1, dist="t");
print "";

print "Normal vs Student's t errors";
print "============================";
print sprintf("%-16s %14s %12s %12s", "", "Log lik.", "AIC", "BIC");
print sprintf("%-16s %14.4f %12.4f %12.4f", "Normal", fit_norm.loglik, fit_norm.aic, fit_norm.bic);
print sprintf("%-16s %14.4f %12.4f %12.4f", "Student's t", fit_t.loglik, fit_t.aic, fit_t.bic);
print sprintf("Degrees of freedom of the t fit: %.2f", fit_t.nu);
